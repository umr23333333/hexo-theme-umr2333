
<div class="mdui-row main-post-container">
  <div class="mdui-col-xs-12 mdui-col-md-8 mdui-col-offset-md-2">
    <article class="post-detail-card">
      <h1 class="post-detail-title">搜索</h1>

      <div style="padding: 16px 0;">
        <div class="mdui-textfield">
          <input
            class="mdui-textfield-input"
            type="search"
            id="site-search-input"
            placeholder="输入关键词搜索文章..."
            autocomplete="off"
          >
        </div>
        <div id="site-search-results" aria-live="polite"></div>
      </div>
    </article>
  </div>
</div>

<script>
(function () {
  const input = document.getElementById('site-search-input');
  const results = document.getElementById('site-search-results');

  if (!input || !results) return;

  const posts = [
    <% site.posts.sort('-date').each(function(post) { %>
    {
      title: <%- JSON.stringify(post.title || '') %>,
      url: <%- JSON.stringify(url_for(post.path)) %>,
      content: <%- JSON.stringify(post.content || '') %>,
      date: <%- JSON.stringify(post.date.format('YYYY-MM-DD')) %>
    },
    <% }); %>
  ];

  function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, function (char) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[char];
    });
  }

  function search() {
    const keyword = input.value.trim().toLowerCase();

    if (!keyword) {
      results.innerHTML = '<p>输入关键词开始搜索。</p>';
      return;
    }

    const matched = posts.filter(function (post) {
      return (post.title + ' ' + post.content)
        .toLowerCase()
        .includes(keyword);
    }).slice(0, 50);

    if (!matched.length) {
      results.innerHTML = '<p>没有找到相关文章。</p>';
      return;
    }

    results.innerHTML = '<p>找到 ' + matched.length +
      ' 篇相关文章：</p>' + matched.map(function (post) {
        const text = post.content.replace(/<[^>]*>/g, ' ')
          .replace(/\s+/g, ' ')
          .slice(0, 160);

        return '<div style="padding:12px 0;border-bottom:1px solid var(--border-color, #ddd);">' +
          '<a href="' + escapeHTML(post.url) + '">' +
          escapeHTML(post.title) + '</a>' +
          '<div style="font-size:0.85em;opacity:.7;margin:6px 0;">' +
          escapeHTML(post.date) + '</div>' +
          '<div>' + escapeHTML(text) + '</div></div>';
      }).join('');
  }

  input.addEventListener('input', search);

  const params = new URLSearchParams(window.location.search);
  if (params.get('q')) {
    input.value = params.get('q');
    search();
  } else {
    results.innerHTML = '<p>输入关键词开始搜索。</p>';
  }
})();
</script>
