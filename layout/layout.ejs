<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- 引入 Pjax 库 -->
  <script src="https://cdn.jsdelivr.net/npm/pjax/pjax.min.js"></script>

  <% 
    var pageTitle = '';
    if (page.title) {
      pageTitle = page.title + ' - ' + config.title;
    } else {
      pageTitle = config.title + (config.subtitle ? ' - ' + config.subtitle : '');
    }
  %>
  <title><%= pageTitle %></title>
  
  <link rel="icon" type="image/png" href="<%= url_for('/img/favicon.png') %>">
  
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/mdui@1.0.2/dist/css/mdui.min.css"/>
  <%- css('css/style.css') %>
</head>
<body>

  <% var bgUrl = theme.background || url_for('/img/back.jpg'); %>
  <div class="full-bg" style="background-image: url('<%= bgUrl %>');"></div>

  <div class="mdui-appbar mdui-appbar-fixed mdui-shadow-0 appbar-transparent">
    <div class="mdui-toolbar">
      <% if (theme.sidebar && theme.sidebar.enable) { %>
        <span class="mdui-btn mdui-btn-icon" mdui-drawer="{target: '#left-drawer'}">
          <i class="mdui-icon material-icons">menu</i>
        </span>
      <% } %>
      <div class="mdui-toolbar-spacer"></div>
    </div>
  </div>

  <% if (theme.sidebar && theme.sidebar.enable) { %>
    <div class="mdui-drawer mdui-drawer-close custom-drawer" id="left-drawer">
      <ul class="mdui-list">
        <% if (theme.menu && theme.menu.length > 0) { %>
          <% theme.menu.forEach(function(item) { %>
            <a href="<%= url_for(item.link) %>" class="mdui-list-item mdui-ripple">
              <% if (item.icon) { %>
                <% if (item.icon.indexOf('fa') !== -1) { %>
                  <i class="mdui-list-item-icon <%= item.icon %>" style="display: flex; align-items: center; justify-content: center; font-size: 1.25rem;"></i>
                <% } else { %>
                  <i class="mdui-list-item-icon mdui-icon material-icons"><%= item.icon %></i>
                <% } %>
              <% } %>
              <div class="mdui-list-item-content"><%= item.name %></div>
            </a>
          <% }); %>
        <% } %>
      </ul>
    </div>
  <% } %>

  <main class="main-container" id="pjax-container">
    <%- body %>
  </main>

  <footer class="site-footer">
    <% if (theme.footer && theme.footer.custom_text && theme.footer.custom_text.enable) { %>
      <div class="footer-custom">
        <%- theme.footer.custom_text.content %>
      </div>
    <% } %>
    <div class="footer-copyright">
      Powered by <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a> | Theme by <a href="https://github.com/umr23333333/hexo-theme-umr2333" target="_blank" rel="noopener">umr2333 1.2.9</a>
    </div>
  </footer>

  <div class="fab-group-fixed">
    <% if (theme.bgm && theme.bgm.enable && theme.bgm.url) { %>
      <button id="bgm-toggle-btn" class="fab-btn" mdui-tooltip="{content: '背景音乐', position: 'left'}" style="width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; border: none; outline: none; background: rgba(255, 255, 255, 0.9); box-shadow: 0 2px 8px rgba(0,0,0,0.15); -webkit-tap-highlight-color: transparent;">
        <i class="mdui-icon material-icons" id="bgm-icon" style="font-size: 20px; color: #777; transition: transform 0.3s ease;">volume_off</i>
      </button>
    <% } %>

    <% 
      var defaultLang = (config.language || 'zh-CN').toLowerCase();
      var isDefaultTraditional = defaultLang === 'zh-tw' || defaultLang === 'zh-hk';
    %>
    <% if (theme.lang_toggle && theme.lang_toggle.enable) { %>
      <button id="lang-toggle-btn" class="fab-btn" mdui-tooltip="{content: '切换繁简体', position: 'left'}">
        <span id="lang-toggle-text" style="font-weight: bold; font-size: 1.1rem;"><%= isDefaultTraditional ? '简' : '繁' %></span>
      </button>
    <% } %>

    <button id="dark-mode-toggle" class="fab-btn" mdui-tooltip="{content: '切换夜间模式', position: 'left'}">
      <i class="mdui-icon material-icons" id="dark-icon">brightness_4</i>
    </button>
    
    <button id="scroll-top-btn" class="fab-btn" mdui-tooltip="{content: '回到顶部', position: 'left'}">
      <span id="scroll-progress-text" style="display: inline-block;">0%</span>
      <i class="mdui-icon material-icons" id="scroll-top-icon" style="display: none !important;">keyboard_arrow_up</i>
    </button>
  </div>

  <script src="https://unpkg.com/mdui@1.0.2/dist/js/mdui.min.js"></script>

  <script>
    var pjax;
    document.addEventListener('DOMContentLoaded', function () {
      if (window.Pjax && window.pjax) {
        try { window.pjax.destroy(); } catch (e) {}
      }

      pjax = new Pjax({
        selectors: [
          'title',
          '#pjax-container'
        ],
        cacheBust: false
      });

      if (pjax && typeof pjax.loadUrl === 'function') {
        const originalLoadUrl = pjax.loadUrl.bind(pjax);
        pjax.loadUrl = function(destination, options) {
          try {
            const urlObj = new URL(destination, window.location.origin);
            urlObj.protocol = window.location.protocol;
            destination = urlObj.href;
          } catch (err) {}
          return originalLoadUrl(destination, options);
        };
      }
    });

    document.addEventListener('pjax:error', function (event) {
      if (event.triggerElement && event.triggerElement.href) {
        let fallbackUrl = event.triggerElement.href;
        try {
          const urlObj = new URL(fallbackUrl, window.location.origin);
          urlObj.protocol = window.location.protocol;
          fallbackUrl = urlObj.href;
        } catch (e) {}
        window.location.href = fallbackUrl;
      }
    });

    document.addEventListener('pjax:complete', function () {
      if (window.mdui) {
        mdui.mutation();
      }
      if (typeof window.syncBgmUI === 'function') {
        window.syncBgmUI();
      }
    });
  </script>

  <% if (theme.lang_toggle && theme.lang_toggle.enable) { %>
    <script src="https://cdn.jsdelivr.net/npm/opencc-js@1.0.5/dist/umd/full.js"></script>
    <script>
      (function() {
        const defaultIsTraditional = <%= isDefaultTraditional %>;
        const converterS2T = OpenCC.Converter({ from: 'cn', to: 'hk' });
        const converterT2S = OpenCC.Converter({ from: 'hk', to: 'cn' });

        function convertTextNodes(converter) {
          const walk = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            {
              acceptNode: function(node) {
                const parentName = node.parentElement ? node.parentElement.tagName : '';
                if (['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(parentName)) {
                  return NodeFilter.FILTER_REJECT;
                }
                if (node.parentElement && (node.parentElement.id === 'lang-toggle-text' || node.parentElement.id === 'scroll-progress-text')) {
                  return NodeFilter.FILTER_REJECT;
                }
                return NodeFilter.FILTER_ACCEPT;
              }
            },
            false
          );

          let node;
          while ((node = walk.nextNode())) {
            if (node.nodeValue && node.nodeValue.trim().length > 0) {
              node.nodeValue = converter(node.nodeValue);
            }
          }
        }

        function applyCurrentLanguage() {
          const langText = document.getElementById('lang-toggle-text');
          const currentTarget = localStorage.getItem('theme_lang_target');
          
          if (!currentTarget) {
            if (langText) langText.innerText = defaultIsTraditional ? '简' : '繁';
            return;
          }

          if (currentTarget === 'zh-TW') {
            if (langText) langText.innerText = '简';
            convertTextNodes(converterS2T);
          } else if (currentTarget === 'zh-CN') {
            if (langText) langText.innerText = '繁';
            convertTextNodes(converterT2S);
          }
        }

        applyCurrentLanguage();
        document.addEventListener('pjax:complete', applyCurrentLanguage);

        function bindLangToggleEvent() {
          const langBtn = document.getElementById('lang-toggle-btn');
          if (!langBtn) return;

          langBtn.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();

            const currentTarget = localStorage.getItem('theme_lang_target') || (defaultIsTraditional ? 'zh-TW' : 'zh-CN');
            let nextTarget = (currentTarget === 'zh-CN') ? 'zh-TW' : 'zh-CN';

            localStorage.setItem('theme_lang_target', nextTarget);
            applyCurrentLanguage();
          };
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindLangToggleEvent);
        } else {
          bindLangToggleEvent();
        }
        document.addEventListener('pjax:complete', bindLangToggleEvent);
      })();
    </script>
  <% } %>

  <script>
    (function() {
      function applyTheme(isDark) {
        const darkIcon = document.getElementById('dark-icon');
        if (isDark) {
          document.documentElement.classList.add('dark');
          if (darkIcon) darkIcon.innerText = 'brightness_7';
        } else {
          document.documentElement.classList.remove('dark');
          if (darkIcon) darkIcon.innerText = 'brightness_4';
        }
      }

      const savedTheme = localStorage.getItem('theme_dark') === 'true';
      applyTheme(savedTheme);

      function bindDarkToggleEvent() {
        const toggleBtn = document.getElementById('dark-mode-toggle');
        if (!toggleBtn) return;

        toggleBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();

          const isDark = document.documentElement.classList.toggle('dark');
          const darkIcon = document.getElementById('dark-icon');
          if (darkIcon) darkIcon.innerText = isDark ? 'brightness_7' : 'brightness_4';
          localStorage.setItem('theme_dark', isDark);
        };
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindDarkToggleEvent);
      } else {
        bindDarkToggleEvent();
      }

      const scrollTopBtn = document.getElementById('scroll-top-btn');
      const progressText = document.getElementById('scroll-progress-text');
      const scrollTopIcon = document.getElementById('scroll-top-icon');

      function updateScrollProgress() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
        const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight || 0;
        const clientHeight = document.documentElement.clientHeight || window.innerHeight || 0;

        const maxScroll = scrollHeight - clientHeight;
        let progress = 0;

        if (maxScroll > 0) {
          progress = Math.min(100, Math.max(0, Math.round((scrollTop / maxScroll) * 100)));
        } else {
          progress = 100;
        }

        if (progress >= 100) {
          if (progressText) progressText.style.setProperty('display', 'none', 'important');
          if (scrollTopIcon) scrollTopIcon.style.setProperty('display', 'inline-block', 'important');
        } else {
          if (progressText) {
            progressText.style.setProperty('display', 'inline-block', 'important');
            progressText.innerText = progress + '%';
          }
          if (scrollTopIcon) scrollTopIcon.style.setProperty('display', 'none', 'important');
        }
      }

      window.addEventListener('scroll', updateScrollProgress);
      window.addEventListener('resize', updateScrollProgress);
      document.addEventListener('DOMContentLoaded', updateScrollProgress);

      if (scrollTopBtn) {
        scrollTopBtn.onclick = function() {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        };
      }

      document.addEventListener('pjax:complete', function() {
        const isDark = localStorage.getItem('theme_dark') === 'true';
        applyTheme(isDark);
        updateScrollProgress();
        bindDarkToggleEvent();
      });
    })();
  </script>

  <% if (theme.bgm && theme.bgm.enable && theme.bgm.url) { %>
    <style>
      @keyframes music-rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .bgm-playing #bgm-icon {
        animation: music-rotate 3s linear infinite;
        color: #3f51b5 !important;
      }
    </style>

    <script>
      (function () {
        const BGM_TIME_KEY = 'umr_blog_bgm_time';
        const BGM_STATE_KEY = 'umr_blog_bgm_playing';

        if (!window.__globalBgmPlayer) {
          window.__globalBgmPlayer = document.createElement('audio');
          window.__globalBgmPlayer.src = '<%= theme.bgm.url %>';
          window.__globalBgmPlayer.loop = true;
          window.__globalBgmPlayer.preload = 'auto';
          
          var savedTime = localStorage.getItem(BGM_TIME_KEY);
          if (savedTime) {
            window.__globalBgmPlayer.currentTime = parseFloat(savedTime);
          }
          
          document.body.appendChild(window.__globalBgmPlayer);
        }

        var bgmPlayer = window.__globalBgmPlayer;
        var isAutoplay = <%= Boolean(theme.bgm.autoplay) %>;

        bgmPlayer.addEventListener('timeupdate', function () {
          if (!bgmPlayer.paused) {
            localStorage.setItem(BGM_TIME_KEY, bgmPlayer.currentTime);
          }
        });

        window.syncBgmUI = function() {
          var bgmBtn = document.getElementById('bgm-toggle-btn');
          var bgmIcon = document.getElementById('bgm-icon');
          if (!bgmBtn || !bgmIcon) return;

          if (!bgmPlayer.paused) {
            bgmBtn.classList.add('bgm-playing');
            bgmIcon.textContent = 'music_note';
          } else {
            bgmBtn.classList.remove('bgm-playing');
            bgmIcon.textContent = 'volume_off';
          }
        };

        function tryPlayBgm() {
          var promise = bgmPlayer.play();
          if (promise !== undefined) {
            promise.then(function () {
              localStorage.setItem(BGM_STATE_KEY, 'true');
              window.syncBgmUI();
            }).catch(function (err) {
              window.syncBgmUI();
            });
          }
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('#bgm-toggle-btn');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            if (bgmPlayer.paused) {
              bgmPlayer.play().then(function() {
                localStorage.setItem(BGM_STATE_KEY, 'true');
                window.syncBgmUI();
              });
            } else {
              bgmPlayer.pause();
              localStorage.setItem(BGM_STATE_KEY, 'false');
              window.syncBgmUI();
            }
          }
        });

        window.addEventListener('beforeunload', function () {
          localStorage.setItem(BGM_TIME_KEY, bgmPlayer.currentTime);
          localStorage.setItem(BGM_STATE_KEY, !bgmPlayer.paused);
        });

        var wasPlaying = localStorage.getItem(BGM_STATE_KEY) === 'true';
        if (wasPlaying || isAutoplay) {
          tryPlayBgm();

          var unlockHandler = function () {
            if (bgmPlayer.paused && localStorage.getItem(BGM_STATE_KEY) === 'true') {
              tryPlayBgm();
            }
            ['click', 'touchstart', 'pointerdown', 'mousedown', 'keydown'].forEach(function (evt) {
              document.removeEventListener(evt, unlockHandler, true);
            });
          };
          ['click', 'touchstart', 'pointerdown', 'mousedown', 'keydown'].forEach(function (evt) {
            document.addEventListener(evt, unlockHandler, true);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', window.syncBgmUI);
        } else {
          window.syncBgmUI();
        }
      })();
    </script>
  <% } %>

  <% if (theme.falling_effect && theme.falling_effect.enable) { %>
    <style>
      #falling-canvas {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        pointer-events: none !important;
        z-index: 999999 !important;
      }
    </style>

    <script>
      (function () {
        function initFallingEffect() {
          if (document.getElementById('falling-canvas')) return;

          var config = {
            type: '<%= theme.falling_effect.type || "sakura" %>',
            count: <%= Number(theme.falling_effect.count) || 30 %>
          };

          var canvas = document.createElement('canvas');
          canvas.id = 'falling-canvas';
          document.body.appendChild(canvas);

          var ctx = canvas.getContext('2d');
          var width = (canvas.width = window.innerWidth);
          var height = (canvas.height = window.innerHeight);

          window.addEventListener('resize', function () {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
          });

          var particles = [];
          var particleCount = config.count;

          function Particle() {
            this.reset();
          }

          Particle.prototype.reset = function () {
            this.x = Math.random() * width;
            this.y = Math.random() * -height;
            this.size = Math.random() * 8 + 6;
            this.speedY = Math.random() * 1.2 + 0.8;
            this.speedX = Math.random() * 1 - 0.5;
            this.rotation = Math.random() * 360;
            this.rotationSpeed = (Math.random() - 0.5) * 1.5;
            this.opacity = Math.random() * 0.5 + 0.5;
          };

          Particle.prototype.update = function () {
            this.y += this.speedY;
            this.x += Math.sin(this.y / 30) + this.speedX;
            this.rotation += this.rotationSpeed;

            if (this.y > height || this.x < -20 || this.x > width + 20) {
              this.reset();
              this.y = -10;
            }
          };

          Particle.prototype.draw = function () {
            ctx.save();
            ctx.translate(this.x, this.y);
            ctx.rotate((this.rotation * Math.PI) / 180);
            ctx.globalAlpha = this.opacity;

            if (config.type === 'snow') {
              ctx.beginPath();
              ctx.arc(0, 0, this.size / 2.5, 0, Math.PI * 2);
              ctx.fillStyle = '#ffffff';
              ctx.shadowBlur = 4;
              ctx.shadowColor = 'rgba(255, 255, 255, 0.8)';
              ctx.fill();
            } else if (config.type === 'heart') {
              ctx.beginPath();
              ctx.moveTo(0, 0);
              ctx.bezierCurveTo(-this.size / 2, -this.size / 2, -this.size, this.size / 3, 0, this.size);
              ctx.bezierCurveTo(this.size, this.size / 3, this.size / 2, -this.size / 2, 0, 0);
              ctx.fillStyle = '#ffb7c5';
              ctx.fill();
            } else {
              ctx.beginPath();
              ctx.moveTo(0, 0);
              ctx.quadraticCurveTo(-this.size / 2, this.size / 2, 0, this.size);
              ctx.quadraticCurveTo(this.size / 2, this.size / 2, 0, 0);
              ctx.fillStyle = '#ffc0cb';
              ctx.fill();
            }

            ctx.restore();
          };

          for (var i = 0; i < particleCount; i++) {
            var p = new Particle();
            p.y = Math.random() * height;
            particles.push(p);
          }

          function render() {
            ctx.clearRect(0, 0, width, height);
            for (var i = 0; i < particles.length; i++) {
              particles[i].update();
              particles[i].draw();
            }
            requestAnimationFrame(render);
          }

          render();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initFallingEffect);
        } else {
          initFallingEffect();
        }
      })();
    </script>
  <% } %>

</body>
</html>